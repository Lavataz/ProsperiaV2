# Prosperia V2 bot — omgevingsvariabelen
# Kopieer naar .env en vul in. .env NOOIT committen.

PROSPERIA_API_URL=https://aertsconnect.nl/prosperia/api
PROSPERIA_API_USER=bot@prosperia.local
PROSPERIA_API_PASS=verander-dit

PROSPERIA_LOG_LEVEL=INFO
PROSPERIA_LOG_FILE=logs/prosperia.log

PROSPERIA_POLL_INTERVAL=5
PROSPERIA_CONFIG_REFRESH_INTERVAL=30
